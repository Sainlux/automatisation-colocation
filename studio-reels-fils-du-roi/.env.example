# Copie ce fichier en .env et mets ta clé API Claude (console.anthropic.com > API Keys).
# Ne partage jamais ce fichier. Sans clé, le Studio marche quand même, sauf « Décris ton style » et les prompts automatiques.
ANTHROPIC_API_KEY=
# Facultatif : modèle utilisé (par défaut claude-sonnet-5-5)
CLAUDE_MODEL=claude-sonnet-5-5
PORT=8787
