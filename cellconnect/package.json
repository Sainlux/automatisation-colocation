    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
