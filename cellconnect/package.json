{
  "name": "cellconnect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "worker": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/worker.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:supabase": "vitest run --config vitest.integration.config.mts",
    "vapid": "node scripts/vapid.mjs",
    "telegram:webhook": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/telegram-webhook.ts"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/luxon3": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "luxon": "^3.7.2",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "openai": "^7.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rrule": "^2.8.1",
    "server-only": "^0.0.1",
