# =============================================================================
# CellConnect AI — variables d'environnement
# Copier vers .env.local (développement) ou les définir dans Vercel.
# Ne JAMAIS committer de vraies valeurs.
# =============================================================================

# --- Application --------------------------------------------------------------
APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Europe/Zurich
# Secret de signature des sessions (mode local) et de l'état OAuth. 32+ caractères aléatoires :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Données ------------------------------------------------------------------
# local    : fichier JSON privé dans DATA_DIR (démonstration, une seule instance)
# supabase : PostgreSQL + Auth + Storage (production)
# Si vide : supabase dès que l'URL et la clé service sont définies, sinon local.
DATA_BACKEND=
DATA_DIR=.data

# --- Supabase (voir docs/SUPABASE.md) ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement — jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CAPTURES_BUCKET=captures

# --- IA (voir docs/OPENAI.md) --------------------------------------------------
# Sans clé : seul le texte collé et les .ics sont analysés (localement).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- E-mail (SMTP) ------------------------------------------------------------
# Sans SMTP : les e-mails sont marqués « Non envoyé » (jamais prétendus envoyés).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CellConnect AI <no-reply@votre-domaine.ch>"

# --- Google Calendar (voir docs/GOOGLE_CALENDAR.md) ----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clé AES-256 (32 octets en base64) pour chiffrer les jetons OAuth :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Outlook / Microsoft 365 et Zoom (voir docs/OUTLOOK_ZOOM.md) -------------
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Notifications push web ---------------------------------------------------
# Générer avec : npm run vapid   (aucun compte externe nécessaire)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@votre-domaine.ch

# --- Conservation des données (jours) -----------------------------------------
RETENTION_EXTRACTION_DAYS=30
RETENTION_NOTIFICATION_DAYS=180
RETENTION_AUDIT_DAYS=365
RETENTION_CONFLICT_DAYS=180
RETENTION_REMINDER_DAYS=90
RETENTION_TASK_DAYS=30
RETENTION_IDEMPOTENCY_DAYS=7

# --- Tâches planifiées --------------------------------------------------------
# Protège /api/cron/tick (en-tête Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
WORKER_INTERVAL_MS=30000

# --- Limites d'import ---------------------------------------------------------
MAX_IMAGE_BYTES=10485760
MAX_PDF_BYTES=15728640
MAX_TEXT_CHARS=20000
MAX_FILES_PER_ANALYSIS=5
