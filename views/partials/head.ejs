          { href:'/historique',   k:'historique',   label:'Documents',         num:'vi',   group:'Cabinet'    },
          { href:'/proprietaire', k:'proprietaire', label:'Direction',         num:'vii',  group:'Cabinet'    }
        ]; %>
        <% for (const it of navItems) { %>
          <li class="border-b border-border">
            <a href="<%= it.href %>" class="flex items-baseline gap-5 py-5 <%= _p===it.k ? 'text-wine' : 'text-ink' %>">
              <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-ink3 w-7"><%= it.num %>.</span>
              <span class="font-display text-3xl leading-none <%= _p===it.k ? 'italic' : '' %>"><%= it.label %></span>
            </a>
          </li>
        <% } %>
      </ul>

