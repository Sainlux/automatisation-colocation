<%- include('partials/head') %>

<!-- ───────── MASTHEAD — date / météo administrative / volume ───────── -->
<div class="-mx-5 sm:-mx-7 md:-mx-10 px-5 sm:px-7 md:px-10 mb-10 md:mb-14 masthead rise rise-1">
  <span class="truncate"><%= dateFR %></span>
  <span class="hidden md:inline">Maison · Annemasse · Haute-Savoie</span>
  <span class="shrink-0">Vol. I · N° <%= String(stats.docsTotal % 100 || 1).padStart(2,'0') %></span>
</div>

<!-- ───────── HERO ─────────────────────────────────────────────────── -->
<section class="grid lg:grid-cols-12 gap-8 md:gap-10 mb-16 md:mb-24 items-end rise rise-2">
  <!-- Left : monogram + hero title -->
  <div class="lg:col-span-8">
    <div class="flex items-center gap-4 mb-6 md:mb-7">
      <span class="monogram vt-hero">CM</span>
      <div>
        <div class="eyebrow leading-none">Cabinet de gérance privée</div>
        <div class="text-[11.5px] text-ink3 mt-1.5 font-mono">Établi à Annemasse · MMXXVI</div>
      </div>
    </div>

    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-[120px] leading-[0.92] md:leading-[0.88] tracking-tightish mb-3 break-words">
      <%= (typeof salutation !== 'undefined' ? salutation : 'Bonjour') %>,<br>
      <span class="italic text-wine">Ghebrenegus</span>.
    </h1>

    <p class="font-display italic text-xl sm:text-2xl text-ink2 leading-snug max-w-xl mt-5 md:mt-7">
      Les papiers du quotidien, traités avec la patience d'un notaire et la précision d'un horloger.
    </p>
  </div>

  <!-- Right : Status panel (today's brief) -->
  <aside class="lg:col-span-4 lg:pl-6 lg:border-l lg:border-border self-stretch flex flex-col justify-between">
    <div>
      <div class="eyebrow mb-4">Carnet du jour</div>
      <dl class="space-y-3.5 text-sm">
        <div class="flex justify-between items-baseline gap-3 border-b border-border pb-3">
          <dt class="text-ink3">Colocataires actifs</dt>
          <dd class="font-display text-2xl"><%= stats.colocActifs %></dd>
        </div>
        <div class="flex justify-between items-baseline gap-3 border-b border-border pb-3">
          <dt class="text-ink3">Documents archivés</dt>
          <dd class="font-display text-2xl"><%= stats.docsTotal %></dd>
        </div>
        <div class="flex justify-between items-baseline gap-3 border-b border-border pb-3">
          <dt class="text-ink3">Brouillons à finaliser</dt>
          <dd class="font-display text-2xl <%= stats.brouillons ? 'text-wine italic' : 'text-ink3' %>"><%= stats.brouillons %></dd>
        </div>
        <div class="flex justify-between items-baseline gap-3">
          <dt class="text-ink3">Envoyés par courriel</dt>
          <dd class="font-display text-2xl"><%= stats.envoyes %></dd>
        </div>
      </dl>
    </div>
    <div class="mt-8 pt-5 border-t border-border">
      <a href="/tableau" class="text-[12.5px] font-mono uppercase tracking-[0.18em] text-ink2 link-underline">Tableau de bord →</a>
    </div>
  </aside>
</section>

<!-- ───────── ORNAMENT RULE ─────────────────────────────────────────── -->
<div class="ornament-rule mb-10 md:mb-12 rise rise-3"><span>I · Préparer</span></div>

<!-- ───────── EDITORIAL ENTRY — drop cap + 3 actions ─────────────────── -->
<section class="grid lg:grid-cols-12 gap-8 md:gap-10 mb-16 md:mb-24 rise rise-3">
  <div class="lg:col-span-5">
    <p class="dropcap text-[15px] sm:text-[15.5px] leading-[1.65] text-ink2 max-w-md ed-justify">
      <strong class="text-ink">Bienvenue.</strong> Ce cabinet vous accompagne dans la gestion administrative de votre colocation au 5, rue René Blanc — attestations de domiciliation, quittances de loyer, factures. Chaque pièce est préparée à votre nom, signée de votre main, et archivée avec soin.
    </p>
    <div class="mt-6 text-[12px] font-mono uppercase tracking-[0.18em] text-ink3">— Direction du cabinet</div>
  </div>

  <div class="lg:col-span-7 grid gap-4">
    <a href="/tableau" class="group flex items-center gap-4 sm:gap-6 p-5 sm:p-6 card card-hover min-h-[44px]">
      <div class="font-display text-4xl sm:text-5xl text-ink3 group-hover:text-wine transition-colors leading-none w-8 sm:w-10 shrink-0">i.</div>
      <div class="flex-1 min-w-0">
        <div class="font-display text-xl sm:text-2xl leading-tight">Préparer un document</div>
        <div class="text-[13px] sm:text-sm text-ink2 mt-1">Langage naturel ou création directe — type, colocataire, période identifiés automatiquement.</div>
      </div>
      <span class="text-ink3 group-hover:text-wine group-hover:translate-x-1 transition-all text-xl font-display shrink-0">→</span>
    </a>

    <a href="/historique" class="group flex items-center gap-4 sm:gap-6 p-5 sm:p-6 card card-hover min-h-[44px]">
      <div class="font-display text-4xl sm:text-5xl text-ink3 group-hover:text-wine transition-colors leading-none w-8 sm:w-10 shrink-0">ii.</div>
      <div class="flex-1 min-w-0">
        <div class="font-display text-xl sm:text-2xl leading-tight">Consulter les archives</div>
        <div class="text-[13px] sm:text-sm text-ink2 mt-1"><%= stats.docsTotal %> document<%= stats.docsTotal>1?'s':'' %> conservé<%= stats.docsTotal>1?'s':'' %> · <%= stats.brouillons %> brouillon<%= stats.brouillons>1?'s':'' %> en cours.</div>
      </div>
      <span class="text-ink3 group-hover:text-wine group-hover:translate-x-1 transition-all text-xl font-display shrink-0">→</span>
    </a>

    <a href="/colocataires" class="group flex items-center gap-4 sm:gap-6 p-5 sm:p-6 card card-hover min-h-[44px]">
      <div class="font-display text-4xl sm:text-5xl text-ink3 group-hover:text-wine transition-colors leading-none w-8 sm:w-10 shrink-0">iii.</div>
      <div class="flex-1 min-w-0">
        <div class="font-display text-xl sm:text-2xl leading-tight">Tenir les fiches</div>
        <div class="text-[13px] sm:text-sm text-ink2 mt-1">Civilité, dates, coordonnées — saisies une seule fois, jamais redemandées.</div>
      </div>
      <span class="text-ink3 group-hover:text-wine group-hover:translate-x-1 transition-all text-xl font-display shrink-0">→</span>
    </a>
  </div>
</section>

<!-- ───────── ORNAMENT RULE ─────────────────────────────────────────── -->
<div class="ornament-rule mb-10 md:mb-12 rise rise-4"><span>II · Vos colocataires</span></div>

<!-- ───────── COLOCATAIRES — portrait grid ──────────────────────────── -->
<section class="mb-16 md:mb-24 rise rise-4">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6 md:mb-8">
    <div class="max-w-md">
      <h2 class="font-display text-4xl sm:text-5xl leading-none mb-3"><%= colocataires.length === 0 ? 'Aucune présence' : colocataires.length === 1 ? 'Une présence' : colocataires.length === 2 ? 'Deux présences' : colocataires.length === 3 ? 'Trois présences' : colocataires.length + ' présences' %><br><span class="italic text-wine">au cabinet.</span></h2>
      <p class="text-sm text-ink2">Chacune dispose d'une fiche permanente. Saisissez l'information une fois, retrouvez-la sur tous les documents.</p>
    </div>
    <a href="/colocataires" class="text-[12.5px] font-mono uppercase tracking-[0.18em] text-ink2 link-underline self-start sm:self-auto">Toutes les fiches →</a>
  </div>

  <% if (!colocataires.length) { %>
    <div class="empty-state">
      <div class="empty-fleuron">·  ·  ·</div>
      <div class="empty-eyebrow">Cabinet inhabité</div>
      <p class="empty-line">Le registre n'accueille encore aucune présence. Inscrivez la première fiche pour ouvrir le cabinet.</p>
      <a href="/colocataires" class="btn btn-wine">Ouvrir le registre →</a>
    </div>
  <% } else { %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
    <% let portraitIndex = 0; for (const c of colocataires) {
         const last = lastByColoc.get(c.id);
         const civ = c.civilite === 'M' ? 'Monsieur' : c.civilite === 'Mme' ? 'Madame' : '';
         portraitIndex++;
    %>
      <article class="card card-hover p-6 sm:p-7 group">
        <!-- masthead -->
        <div class="flex items-baseline justify-between mb-6 md:mb-7 gap-2">
          <span class="font-mono text-[10px] sm:text-[10.5px] uppercase tracking-[0.18em] sm:tracking-[0.2em] text-ink3">Portrait n° <%= String(portraitIndex).padStart(2,'0') %></span>
          <span class="chip <%= c.actif ? 'chip-issued' : 'chip-draft' %>"><%= c.actif ? 'actif' : 'ancien' %></span>
        </div>
        <!-- name + civility -->
        <div class="mb-1 font-display text-[15px] italic text-ink3"><%= civ || '—' %></div>
        <h3 class="font-display text-3xl sm:text-[34px] leading-[0.95] mb-5 break-words"><%= c.prenom %><br><%= c.nom %></h3>

        <!-- metadata as editorial rows -->
        <dl class="space-y-2 text-[13px] mb-6 md:mb-7">
          <% if (c.chambre) { %>
            <div class="flex justify-between border-b border-border/60 pb-1.5"><dt class="text-ink3">Chambre</dt><dd class="font-mono"><%= c.chambre %></dd></div>
          <% } %>
          <% if (c.date_entree) { %>
            <div class="flex justify-between border-b border-border/60 pb-1.5"><dt class="text-ink3">Entrée</dt><dd class="font-mono"><%= c.date_entree %></dd></div>
          <% } %>
          <% if (c.loyer) { %>
            <div class="flex justify-between border-b border-border/60 pb-1.5"><dt class="text-ink3">Loyer mensuel</dt><dd class="font-mono"><%= c.loyer %> €</dd></div>
          <% } %>
          <% if (last) { %>
            <div class="flex justify-between"><dt class="text-ink3">Dernier document</dt><dd class="capitalize"><%= last.type %></dd></div>
          <% } %>
        </dl>

        <!-- inline action -->
        <form action="/documents/nouveau" method="post" class="flex flex-col sm:flex-row gap-2 pt-5 border-t border-border">
          <input type="hidden" name="colocataire_id" value="<%= c.id %>">
          <select name="type" class="flex-1 !text-[13px]" aria-label="Type de document">
            <option value="attestation">Attestation</option>
            <option value="quittance">Quittance</option>
            <option value="facture">Facture</option>
          </select>
          <button class="btn btn-wine justify-center">Préparer →</button>
        </form>
      </article>
    <% } %>
  </div>
  <% } %>
</section>

<!-- ───────── EDITORIAL PULL QUOTE with signature ───────────────────── -->
<section class="grid lg:grid-cols-12 gap-6 md:gap-10 mb-16 md:mb-20 items-center border-t border-b border-border py-10 md:py-16 rise rise-5">
  <div class="lg:col-span-2 flex justify-center lg:justify-start">
    <span class="monogram" style="width:72px;height:72px;font-size:30px;">CM</span>
  </div>
  <blockquote class="lg:col-span-7">
    <p class="font-display text-2xl sm:text-3xl md:text-[42px] leading-[1.12] md:leading-[1.08] tracking-tightish text-ink">
      « Chaque document, <span class="italic text-wine">préparé avec attention</span>. Chaque adresse, vérifiée deux fois. Chaque signature, posée à sa juste place. »
    </p>
    <footer class="mt-4 md:mt-5 text-[11.5px] font-mono uppercase tracking-[0.22em] text-ink3">— Manière de faire du cabinet</footer>
  </blockquote>
  <div class="lg:col-span-3 lg:pl-8 lg:border-l lg:border-border pt-4 lg:pt-0 border-t lg:border-t-0 border-border">
    <div class="eyebrow mb-2">Cabinet</div>
    <div class="font-display text-lg leading-tight">Ghebrenegus<br>Merhawi</div>
    <div class="text-[12px] text-ink2 mt-2 leading-snug">5, rue René Blanc<br>74100 Annemasse — France</div>
    <% if (proprietaire.email) { %>
      <a href="mailto:<%= proprietaire.email %>" class="text-[12px] text-wine link-underline mt-2 inline-block font-mono break-all"><%= proprietaire.email %></a>
    <% } %>
  </div>
</section>

<!-- ───────── COLOPHON ──────────────────────────────────────────────── -->
<section class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-10 md:mb-12 text-[12px] text-ink3 leading-relaxed rise rise-6">
  <div>
    <div class="eyebrow mb-2 text-ink2">Colophon</div>
    <p class="ed-justify">Application composée en <em>Instrument Serif</em>, <em>Inter</em> et <em>IBM Plex Mono</em>. Mise en page conforme à NF Z 11-001 pour la correspondance administrative française.</p>
  </div>
  <div>
    <div class="eyebrow mb-2 text-ink2">Confidentialité</div>
    <p class="ed-justify">Stockage local exclusif (<code class="font-mono text-[11px]">data/app.db</code>). Aucune donnée ne quitte cet ordinateur, à l'exception des courriels que vous choisissez d'envoyer.</p>
  </div>
  <div>
    <div class="eyebrow mb-2 text-ink2">Édition</div>
    <p class="ed-justify">Vol. I — N° <%= String(stats.docsTotal % 100 || 1).padStart(2,'0') %> · <%= dateFR %><br>Toutes les pièces signées de la main du bailleur, archivées chronologiquement.</p>
  </div>
</section>

<!-- ───────── EDITORIAL CITATION FOOTER ──────────────────────────────── -->
<div class="ornament-fleuron mb-2 hidden md:flex">·</div>
<p class="text-center font-display italic text-[15px] md:text-base text-ink3 mb-8 hidden md:block">
  Diligenter administrare · fideliter archivare.
</p>

<%- include('partials/foot') %>
