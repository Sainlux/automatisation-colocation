# Copier ce fichier vers .env et remplir les valeurs

# Port HTTP local
PORT=3000

# Authentification HTTP Basic (OBLIGATOIRE en production / mise en ligne)
# Si AUTH_USER ou AUTH_PASS est vide, l'app reste ouverte (mode local uniquement)
AUTH_USER=admin
AUTH_PASS=

# Répertoire de stockage (DB SQLite + PDFs).
# Local : laisser vide (utilise ./data)
# Production Fly.io : /data (volume persistant monté)
DATA_DIR=

# SMTP pour l'envoi des emails (ex : Gmail avec mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ghmerhawi@hotmail.com
SMTP_PASS=
SMTP_FROM="Merhawi Ghebre Negus <ghmerhawi@hotmail.com>"

# Signature image (PNG transparent recommandé). Laisser vide pour signature texte.
SIGNATURE_PATH=public/signature.png
